# Skopíruj na .env.local a doplň skutočné hodnoty. .env.local sa necommituje (viď .gitignore).
# Toto sú DEV hodnoty (cloud Supabase projekt) — produkčné (self-hosted na nexus) sa riešia pri nasadení, nie tu.

# Supabase (cloud projekt, Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — NIKDY nesmie mať prefix NEXT_PUBLIC_, používa sa len v server-side kóde (API routes/Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — výhradne server-side (API routes), nikdy vo frontend/kliente
ANTHROPIC_API_KEY=

# Stripe (fáza 3, zatiaľ nepoužité — placeholder pre budúci setup)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
