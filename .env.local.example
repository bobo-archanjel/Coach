# Skopíruj na .env.local a doplň skutočné hodnoty. .env.local sa necommituje (viď .gitignore).
# Toto sú DEV hodnoty (cloud Supabase projekt) — produkčné (self-hosted na nexus) sa riešia pri nasadení, nie tu.

# Supabase (cloud projekt, Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — NIKDY nesmie mať prefix NEXT_PUBLIC_, používa sa len v server-side kóde (lib/supabase/admin.ts).
# Od migrácie 0036 je POVINNÝ pre server: zámok prihlasovania (brute-force), atómová rezervácia AI limitov
# a zápis odpovedí AI kouča. Bez neho appka padá na slabšie záložné správanie (a loguje chybu).
SUPABASE_SERVICE_ROLE_KEY=

# Osobný Supabase token (supabase.com/dashboard/account/tokens) — LEN pre lokálny skript
# scripts/email-templates.mjs (nahratie e-mailových šablón cez Management API). Appka ho
# nepoužíva, do Vercelu NEPATRÍ — má práva na celý Supabase účet, nie len na projekt.
# SUPABASE_ACCESS_TOKEN=

# Claude API — výhradne server-side (API routes), nikdy vo frontend/kliente
ANTHROPIC_API_KEY=

# Cloudflare Turnstile (feature/security) — bot ochrana na /prihlasenie (prihlásenie
# aj registrácia, lib/turnstile.ts).
# Hodnotu secretu over v Cloudflare dashboarde a nastav ju tu (appka beží ako Next.js
# server). Site key (verejný, nie tajný) je natvrdo v app/components/Turnstile.tsx.
# Bez tejto premennej appka beží BEZ CAPTCHA ochrany (loguje varovanie pri každom
# pokuse) — funguje ďalej (napr. lokálny dev bez nastaveného Cloudflare secretu),
# ale v produkcii ju treba nastaviť.
TURNSTILE_SECRET_KEY=

# Stripe predplatné trénerov (feature/Stripe, docs/billing/README.md). Zatiaľ LEN testovacie kľúče
# (sk_test_…) — živé (sk_live_…) až pri ostrom spustení. Žiadne z nich nemá prefix NEXT_PUBLIC_.
# Bez nich appka beží, len platby nefungujú (stránka Predplatné to oznámi).
# Secret key (Stripe Dashboard → Developers → API keys, test mode)
STRIPE_SECRET_KEY=
# Podpisový kľúč webhooku (whsec_…): lokálne z `stripe listen`, na produkcii zo Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=
# ID mesačných cien v EUR (price_…) — vypíše ich `node scripts/stripe-setup.mjs`
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# NEXT_PUBLIC_SITE_URL (nižšie) sa používa aj pre návratové adresy z Checkoutu a Customer Portalu.

# SEO/social metadata (feature/security#2) — skutočná produkčná doména, používa sa
# v metadataBase (Open Graph/Twitter card obrázky), robots.txt a sitemap.xml.
# Bez nastavenia padá appka na "https://myfitpilot.sk" placeholder.
NEXT_PUBLIC_SITE_URL=

# Plausible analytics (feature/security#2) — cookieless, nepotrebuje cookie banner.
# Domain = presne tak, ako je appka zaregistrovaná na plausible.io (napr. myfitpilot.sk).
# Bez nastavenia sa analytics script vôbec nenačíta (viď app/layout.tsx).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# AI stropy (voliteľné, sú tu predvolené hodnoty). Globálny denný strop volaní modelu naprieč všetkými
# trénermi — poistka proti prepáleniu Anthropic kreditu. Limity na trénera sú v lib/ai/rateLimit.ts.
# AI_GLOBAL_DAILY_CALL_CAP=3000

# Open Food Facts — kontaktný e-mail do User-Agent (OFF ho žiada, aby vedel appku osloviť
# namiesto zablokovania IP). Skener čiarových kódov v denníku + vyhľadávanie značiek.
OFF_CONTACT_EMAIL=
