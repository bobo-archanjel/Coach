# Skopíruj na .env.local a doplň skutočné hodnoty. .env.local sa necommituje (viď .gitignore).
# Toto sú DEV hodnoty (cloud Supabase projekt) — produkčné (self-hosted na nexus) sa riešia pri nasadení, nie tu.

# Supabase (cloud projekt, Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — NIKDY nesmie mať prefix NEXT_PUBLIC_, používa sa len v server-side kóde (lib/supabase/admin.ts).
# Od migrácie 0036 je POVINNÝ pre server: zámok prihlasovania (brute-force), atómová rezervácia AI limitov
# a zápis odpovedí AI kouča. Bez neho appka padá na slabšie záložné správanie (a loguje chybu).
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — výhradne server-side (API routes), nikdy vo frontend/kliente
ANTHROPIC_API_KEY=

# Stripe (fáza 3, zatiaľ nepoužité — placeholder pre budúci setup)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# SEO/social metadata (feature/security#2) — skutočná produkčná doména, používa sa
# v metadataBase (Open Graph/Twitter card obrázky), robots.txt a sitemap.xml.
# Bez nastavenia padá appka na "https://fitpilot.sk" placeholder.
NEXT_PUBLIC_SITE_URL=

# Plausible analytics (feature/security#2) — cookieless, nepotrebuje cookie banner.
# Domain = presne tak, ako je appka zaregistrovaná na plausible.io (napr. fitpilot.sk).
# Bez nastavenia sa analytics script vôbec nenačíta (viď app/layout.tsx).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# AI stropy (voliteľné, sú tu predvolené hodnoty). Globálny denný strop volaní modelu naprieč všetkými
# trénermi — poistka proti prepáleniu Anthropic kreditu. Limity na trénera sú v lib/ai/rateLimit.ts.
# AI_GLOBAL_DAILY_CALL_CAP=3000
